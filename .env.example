# Copy this file to .env and replace the empty secrets before starting the server.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# In production, point this at a persistent disk and run a single server instance.
DATA_FILE=./data/fixtures.json
PAYMENTS_FILE=./data/payments.json

# Leave the Daraja settings empty until Safaricom issues the business credentials
# and the production server has a public HTTPS callback URL.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORT_CODE=
DARAJA_BUSINESS_TYPE=paybill
DARAJA_CALLBACK_BASE_URL=
DARAJA_CALLBACK_TOKEN=
DARAJA_ACCOUNT_REFERENCE=ROYALBETS
